-- =============================================
-- USEFUL VIEWS
-- =============================================

-- Active properties with all related data
CREATE VIEW v_active_properties AS
SELECT
    p.*,
    pi.image_url as primary_image,
    pr.full_name as agent_name,
    pr.phone as agent_phone,
    pr.agency_name,
    pr.avatar_url as agent_avatar,
    l.name as location_name,
    l.region as location_region,
    array_agg(DISTINCT a.name) FILTER (WHERE a.name IS NOT NULL) as amenities
FROM properties p
LEFT JOIN property_images pi ON p.id = pi.property_id AND pi.is_primary = true
LEFT JOIN profiles pr ON p.agent_id = pr.id
LEFT JOIN locations l ON p.location_id = l.id
LEFT JOIN property_amenities pa ON p.id = pa.property_id
LEFT JOIN amenities a ON pa.amenity_id = a.id
WHERE p.status = 'active'
GROUP BY p.id, pi.image_url, pr.full_name, pr.phone, pr.agency_name, pr.avatar_url, l.name, l.region;

-- Featured properties
CREATE VIEW v_featured_properties AS
SELECT * FROM v_active_properties
WHERE featured = true
ORDER BY created_at DESC;

-- Property statistics view
CREATE VIEW v_property_stats AS
SELECT
    DATE_TRUNC('month', created_at) as month,
    property_type,
    listing_type,
    city,
    COUNT(*) as total_properties,
    AVG(price) as avg_price,
    MIN(price) as min_price,
    MAX(price) as max_price,
    SUM(views_count) as total_views,
    COUNT(*) FILTER (WHERE featured = true) as featured_count
FROM properties
WHERE status = 'active'
GROUP BY DATE_TRUNC('month', created_at), property_type, listing_type, city;

-- Agent performance view
CREATE VIEW v_agent_performance AS
SELECT
    pr.id,
    pr.full_name,
    pr.email,
    pr.agency_name,
    COUNT(p.id) as total_properties,
    COUNT(p.id) FILTER (WHERE p.status = 'active') as active_properties,
    COUNT(p.id) FILTER (WHERE p.status = 'sold') as sold_properties,
    COUNT(p.id) FILTER (WHERE p.featured = true) as featured_properties,
    SUM(p.views_count) as total_views,
    COUNT(i.id) as total_inquiries,
    AVG(p.price) as avg_property_price,
    MAX(p.created_at) as last_property_date
FROM profiles pr
LEFT JOIN properties p ON pr.id = p.agent_id
LEFT JOIN inquiries i ON pr.id = i.agent_id
WHERE pr.role IN ('agent', 'admin')
GROUP BY pr.id, pr.full_name, pr.email, pr.agency_name;

-- Popular locations view
CREATE VIEW v_popular_locations AS
SELECT
    l.id,
    l.name,
    l.type,
    l.region,
    COUNT(p.id) as property_count,
    AVG(p.price) as avg_price,
    l.is_popular
FROM locations l
LEFT JOIN properties p ON l.id = p.location_id AND p.status = 'active'
GROUP BY l.id, l.name, l.type, l.region, l.is_popular
ORDER BY l.is_popular DESC, property_count DESC, l.display_order;

-- =============================================
-- GRANTS AND PERMISSIONS
-- =============================================

GRANT USAGE ON SCHEMA public TO authenticated, anon;
GRANT ALL ON ALL TABLES IN SCHEMA public TO authenticated;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO anon;
GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO authenticated;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO authenticated, anon;

-- Grant select on views
GRANT SELECT ON v_active_properties TO authenticated, anon;
GRANT SELECT ON v_featured_properties TO authenticated, anon;
GRANT SELECT ON v_property_stats TO authenticated, anon;
GRANT SELECT ON v_agent_performance TO authenticated, anon;
GRANT SELECT ON v_popular_locations TO authenticated, anon;

-- Configuration tables read access
GRANT SELECT ON locations TO authenticated, anon;
GRANT SELECT ON amenities TO authenticated, anon;
GRANT SELECT ON settings TO authenticated, anon;

-- =============================================
-- SAMPLE DATA INSERTION FUNCTION
-- =============================================

CREATE OR REPLACE FUNCTION insert_sample_properties(agent_user_id UUID)
RETURNS INTEGER AS $$
DECLARE
    property_count INTEGER := 0;
    prop_id UUID;
    loc_id UUID;
    amenity_ids UUID[];
    i INTEGER;
BEGIN
    -- Get some location IDs
    SELECT id INTO loc_id FROM locations WHERE name = 'Fajara' LIMIT 1;

    -- Get some amenity IDs
    SELECT ARRAY(SELECT id FROM amenities WHERE is_popular = true LIMIT 5) INTO amenity_ids;

    -- Insert sample properties
    FOR i IN 1..10 LOOP
        INSERT INTO properties (
            title, description, price, property_type, listing_type,
            address, city, location_id, bedrooms, bathrooms, square_feet,
            agent_id, featured, parking_spaces, is_furnished
        ) VALUES (
            CASE i
                WHEN 1 THEN 'Luxury 3BR Villa in Fajara'
                WHEN 2 THEN 'Modern 2BR Apartment with Sea View'
                WHEN 3 THEN 'Spacious 4BR Family House'
                WHEN 4 THEN 'Cozy 1BR Studio in Serekunda'
                WHEN 5 THEN 'Executive 5BR Villa with Pool'
                WHEN 6 THEN 'Affordable 2BR House in Sukuta'
                WHEN 7 THEN 'Premium 3BR Condo in Kololi'
                WHEN 8 THEN 'Commercial Office Space'
                WHEN 9 THEN 'Beachfront Villa in Bijilo'
                ELSE 'Investment Property in Bakau'
            END,
            CASE i
                WHEN 1 THEN 'Beautiful modern villa with pool, garden, and sea view. Perfect for families seeking luxury living.'
                WHEN 2 THEN 'Stunning apartment with panoramic ocean views. Modern amenities and prime location.'
                WHEN 3 THEN 'Perfect family home with spacious rooms, large garden, and quiet neighborhood.'
                WHEN 4 THEN 'Ideal for young professionals. Compact, modern, and well-located.'
                WHEN 5 THEN 'Ultimate luxury living with premium finishes and resort-style amenities.'
                WHEN 6 THEN 'Great starter home in a developing area with good potential for appreciation.'
                WHEN 7 THEN 'Modern condo with hotel-style amenities and beach access.'
                WHEN 8 THEN 'Prime commercial space suitable for offices or retail business.'
                WHEN 9 THEN 'Exclusive beachfront property with private beach access.'
                ELSE 'Excellent investment opportunity in a prime location.'
            END,
            CASE i
                WHEN 1 THEN 450000.00
                WHEN 2 THEN 320000.00
                WHEN 3 THEN 280000.00
                WHEN 4 THEN 120000.00
                WHEN 5 THEN 750000.00
                WHEN 6 THEN 180000.00
                WHEN 7 THEN 420000.00
                WHEN 8 THEN 500000.00
                WHEN 9 THEN 920000.00
                ELSE 300000.00
            END,
            CASE i
                WHEN 1 THEN 'villa'::property_type
                WHEN 2 THEN 'apartment'::property_type
                WHEN 3 THEN 'house'::property_type
                WHEN 4 THEN 'apartment'::property_type
                WHEN 5 THEN 'villa'::property_type
                WHEN 6 THEN 'house'::property_type
                WHEN 7 THEN 'condo'::property_type
                WHEN 8 THEN 'commercial'::property_type
                WHEN 9 THEN 'villa'::property_type
                ELSE 'house'::property_type
            END,
            CASE i % 4
                WHEN 0 THEN 'rent'::listing_type
                ELSE 'sale'::listing_type
            END,
            CASE i
                WHEN 1 THEN '15 Ocean Drive'
                WHEN 2 THEN '22 Atlantic Road'
                WHEN 3 THEN '8 Family Close'
                WHEN 4 THEN '101 Market Street'
                WHEN 5 THEN '1 Executive Way'
                WHEN 6 THEN '45 Community Road'
                WHEN 7 THEN '12 Beach Resort'
                WHEN 8 THEN '88 Business District'
                WHEN 9 THEN '3 Beachfront Lane'
                ELSE '67 Investment Street'
            END,
            CASE i % 8
                WHEN 0 THEN 'Banjul'
                WHEN 1 THEN 'Fajara'
                WHEN 2 THEN 'Serekunda'
                WHEN 3 THEN 'Kololi'
                WHEN 4 THEN 'Bakau'
                WHEN 5 THEN 'Sukuta'
                WHEN 6 THEN 'Bijilo'
                ELSE 'Kairaba'
            END,
            loc_id,
            CASE i
                WHEN 1 THEN 3
                WHEN 2 THEN 2
                WHEN 3 THEN 4
                WHEN 4 THEN 1
                WHEN 5 THEN 5
                WHEN 6 THEN 2
                WHEN 7 THEN 3
                WHEN 8 THEN 0
                WHEN 9 THEN 4
                ELSE 3
            END,
            CASE i
                WHEN 1 THEN 2
                WHEN 2 THEN 2
                WHEN 3 THEN 3
                WHEN 4 THEN 1
                WHEN 5 THEN 4
                WHEN 6 THEN 2
                WHEN 7 THEN 2
                WHEN 8 THEN 1
                WHEN 9 THEN 3
                ELSE 2
            END,
            CASE i
                WHEN 1 THEN 2800
                WHEN 2 THEN 1500
                WHEN 3 THEN 3200
                WHEN 4 THEN 600
                WHEN 5 THEN 4500
                WHEN 6 THEN 1200
                WHEN 7 THEN 2000
                WHEN 8 THEN 800
                WHEN 9 THEN 3800
                ELSE 2200
            END,
            agent_user_id,
            i <= 3, -- First 3 are featured
            CASE i % 3
                WHEN 0 THEN 0
                WHEN 1 THEN 1
                ELSE 2
            END,
            i % 2 = 0 -- Every other property is furnished
        ) RETURNING id INTO prop_id;

        -- Add some amenities to each property
        IF amenity_ids IS NOT NULL THEN
            INSERT INTO property_amenities (property_id, amenity_id)
            SELECT prop_id, unnest(amenity_ids[1:3]);
        END IF;

        property_count := property_count + 1;
    END LOOP;

    RETURN property_count;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;