-- =============================================
-- iHomes Real Estate App - Enhanced Professional Schema
-- =============================================

-- Extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pg_trgm";
CREATE EXTENSION IF NOT EXISTS "unaccent";

-- =============================================
-- ENUMS
-- =============================================

CREATE TYPE user_role AS ENUM ('user', 'agent', 'admin');
CREATE TYPE property_status AS ENUM ('active', 'pending', 'sold', 'inactive');
CREATE TYPE property_type AS ENUM ('apartment', 'house', 'condo', 'townhouse', 'villa', 'land', 'commercial');
CREATE TYPE listing_type AS ENUM ('sale', 'rent');
CREATE TYPE inquiry_status AS ENUM ('new', 'contacted', 'scheduled', 'closed');

-- =============================================
-- CONFIGURATION TABLES (Database-driven content)
-- =============================================

-- Locations (regions, cities, districts)
CREATE TABLE locations (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL, -- 'region', 'city', 'district', 'village'
    parent_id UUID REFERENCES locations(id),
    region TEXT,
    latitude DECIMAL(10,8),
    longitude DECIMAL(11,8),
    is_popular BOOLEAN DEFAULT FALSE,
    display_order INTEGER DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Property amenities
CREATE TABLE amenities (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    icon_name TEXT, -- For UI icons
    category TEXT, -- 'interior', 'exterior', 'community', 'utilities'
    is_popular BOOLEAN DEFAULT FALSE,
    display_order INTEGER DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- System settings
CREATE TABLE settings (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    key TEXT NOT NULL UNIQUE,
    value TEXT NOT NULL,
    description TEXT,
    category TEXT DEFAULT 'general',
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- =============================================
-- CORE TABLES
-- =============================================

-- User Profiles (extends Supabase auth.users)
CREATE TABLE profiles (
    id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,
    email TEXT UNIQUE NOT NULL,
    full_name TEXT,
    phone TEXT,
    avatar_url TEXT,
    role user_role DEFAULT 'user',
    agency_name TEXT,
    license_number TEXT,
    bio TEXT,
    website TEXT,
    is_verified BOOLEAN DEFAULT FALSE,
    email_confirmed BOOLEAN DEFAULT FALSE,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Properties
CREATE TABLE properties (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    price DECIMAL(12,2) NOT NULL,
    property_type property_type NOT NULL,
    listing_type listing_type NOT NULL,
    status property_status DEFAULT 'active',

    -- Location
    address TEXT NOT NULL,
    city TEXT NOT NULL,
    location_id UUID REFERENCES locations(id),
    latitude DECIMAL(10,8),
    longitude DECIMAL(11,8),

    -- Property Details
    bedrooms INTEGER DEFAULT 0,
    bathrooms INTEGER DEFAULT 0,
    square_feet INTEGER,
    lot_size INTEGER,
    year_built INTEGER,
    floors INTEGER,

    -- Key Features (most commonly searched)
    parking_spaces INTEGER DEFAULT 0,
    is_furnished BOOLEAN DEFAULT FALSE,

    -- Listing Info
    agent_id UUID REFERENCES profiles(id) NOT NULL,
    featured BOOLEAN DEFAULT FALSE,
    views_count INTEGER DEFAULT 0,
    inquiry_count INTEGER DEFAULT 0,

    -- SEO & Marketing
    slug TEXT UNIQUE,
    meta_title TEXT,
    meta_description TEXT,

    -- Timestamps
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    published_at TIMESTAMPTZ,
    expires_at TIMESTAMPTZ
);

-- Property Images
CREATE TABLE property_images (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    property_id UUID REFERENCES properties(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    caption TEXT,
    is_primary BOOLEAN DEFAULT FALSE,
    display_order INTEGER DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Property Amenities Junction Table
CREATE TABLE property_amenities (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    property_id UUID REFERENCES properties(id) ON DELETE CASCADE,
    amenity_id UUID REFERENCES amenities(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE(property_id, amenity_id)
);

-- User Favorites
CREATE TABLE favorites (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    user_id UUID REFERENCES profiles(id) ON DELETE CASCADE,
    property_id UUID REFERENCES properties(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE(user_id, property_id)
);

-- Contact Inquiries
CREATE TABLE inquiries (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    property_id UUID REFERENCES properties(id) ON DELETE CASCADE,
    inquirer_name TEXT NOT NULL,
    inquirer_email TEXT NOT NULL,
    inquirer_phone TEXT,
    message TEXT NOT NULL,
    agent_id UUID REFERENCES profiles(id),
    status inquiry_status DEFAULT 'new',
    priority INTEGER DEFAULT 1, -- 1=low, 2=medium, 3=high
    scheduled_at TIMESTAMPTZ,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Property Views Tracking
CREATE TABLE property_views (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    property_id UUID REFERENCES properties(id) ON DELETE CASCADE,
    user_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
    ip_address INET,
    user_agent TEXT,
    viewed_at TIMESTAMPTZ DEFAULT NOW()
);

-- Activity Log
CREATE TABLE activity_logs (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    user_id UUID REFERENCES profiles(id) ON DELETE SET NULL,
    action TEXT NOT NULL, -- 'property_created', 'property_updated', 'inquiry_received', etc.
    entity_type TEXT, -- 'property', 'inquiry', 'user'
    entity_id UUID,
    details JSONB,
    ip_address INET,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- =============================================
-- INDEXES FOR PERFORMANCE
-- =============================================

-- Property search indexes
CREATE INDEX idx_properties_status ON properties(status);
CREATE INDEX idx_properties_type_listing ON properties(property_type, listing_type);
CREATE INDEX idx_properties_price ON properties(price);
CREATE INDEX idx_properties_city ON properties(city);
CREATE INDEX idx_properties_location ON properties(location_id);
CREATE INDEX idx_properties_bedrooms ON properties(bedrooms);
CREATE INDEX idx_properties_bathrooms ON properties(bathrooms);
CREATE INDEX idx_properties_featured ON properties(featured, created_at DESC);
CREATE INDEX idx_properties_agent ON properties(agent_id);
CREATE INDEX idx_properties_published ON properties(published_at DESC) WHERE status = 'active';

-- Full-text search index
CREATE INDEX idx_properties_search ON properties
USING gin(to_tsvector('english', title || ' ' || description || ' ' || address || ' ' || city));

-- Trigram indexes for fuzzy search
CREATE INDEX idx_properties_title_trgm ON properties USING gin(title gin_trgm_ops);
CREATE INDEX idx_properties_address_trgm ON properties USING gin(address gin_trgm_ops);
CREATE INDEX idx_locations_name_trgm ON locations USING gin(name gin_trgm_ops);

-- Other useful indexes
CREATE INDEX idx_favorites_user ON favorites(user_id);
CREATE INDEX idx_favorites_property ON favorites(property_id);
CREATE INDEX idx_images_property ON property_images(property_id, is_primary, display_order);
CREATE INDEX idx_property_amenities ON property_amenities(property_id);
CREATE INDEX idx_inquiries_agent ON inquiries(agent_id, status, created_at DESC);
CREATE INDEX idx_inquiries_property ON inquiries(property_id);
CREATE INDEX idx_property_views_property ON property_views(property_id, viewed_at DESC);
CREATE INDEX idx_activity_logs_user ON activity_logs(user_id, created_at DESC);

-- =============================================
-- FUNCTIONS
-- =============================================

-- Auto-update timestamps
CREATE OR REPLACE FUNCTION update_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Generate slug from title
CREATE OR REPLACE FUNCTION generate_slug(title TEXT)
RETURNS TEXT AS $$
BEGIN
    RETURN lower(regexp_replace(
        regexp_replace(title, '[^a-zA-Z0-9\s]', '', 'g'),
        '\s+', '-', 'g'
    ));
END;
$$ LANGUAGE plpgsql;

-- Auto-generate slug for properties
CREATE OR REPLACE FUNCTION set_property_slug()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.slug IS NULL OR NEW.slug = '' THEN
        NEW.slug = generate_slug(NEW.title) || '-' || substring(NEW.id::text, 1, 8);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Update property view count
CREATE OR REPLACE FUNCTION increment_property_views()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE properties
    SET views_count = views_count + 1
    WHERE id = NEW.property_id;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Update inquiry count
CREATE OR REPLACE FUNCTION increment_inquiry_count()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE properties
    SET inquiry_count = inquiry_count + 1
    WHERE id = NEW.property_id;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Handle new user registration
CREATE OR REPLACE FUNCTION handle_new_user()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO profiles (id, email, full_name, role, email_confirmed)
    VALUES (
        NEW.id,
        NEW.email,
        COALESCE(NEW.raw_user_meta_data->>'full_name', ''),
        COALESCE((NEW.raw_user_meta_data->>'role')::user_role, 'user'),
        COALESCE(NEW.email_confirmed_at IS NOT NULL, FALSE)
    );

    -- Log user registration
    INSERT INTO activity_logs (user_id, action, entity_type, entity_id)
    VALUES (NEW.id, 'user_registered', 'user', NEW.id);

    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Update email confirmation status
CREATE OR REPLACE FUNCTION handle_email_confirmation()
RETURNS TRIGGER AS $$
BEGIN
    IF OLD.email_confirmed_at IS NULL AND NEW.email_confirmed_at IS NOT NULL THEN
        UPDATE profiles
        SET email_confirmed = TRUE
        WHERE id = NEW.id;

        -- Log email confirmation
        INSERT INTO activity_logs (user_id, action, entity_type, entity_id)
        VALUES (NEW.id, 'email_confirmed', 'user', NEW.id);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Advanced property search function
CREATE OR REPLACE FUNCTION search_properties(
    search_text TEXT DEFAULT '',
    prop_type property_type DEFAULT NULL,
    list_type listing_type DEFAULT NULL,
    min_price DECIMAL DEFAULT NULL,
    max_price DECIMAL DEFAULT NULL,
    min_beds INTEGER DEFAULT NULL,
    max_beds INTEGER DEFAULT NULL,
    min_baths INTEGER DEFAULT NULL,
    city_name TEXT DEFAULT NULL,
    location_id UUID DEFAULT NULL,
    amenity_ids UUID[] DEFAULT NULL,
    featured_only BOOLEAN DEFAULT FALSE,
    sort_by TEXT DEFAULT 'created_at',
    sort_order TEXT DEFAULT 'DESC',
    limit_results INTEGER DEFAULT 20,
    offset_results INTEGER DEFAULT 0
)
RETURNS TABLE(
    id UUID,
    title TEXT,
    price DECIMAL,
    property_type property_type,
    listing_type listing_type,
    address TEXT,
    city TEXT,
    bedrooms INTEGER,
    bathrooms INTEGER,
    square_feet INTEGER,
    primary_image TEXT,
    agent_name TEXT,
    agent_phone TEXT,
    agency_name TEXT,
    featured BOOLEAN,
    views_count INTEGER,
    created_at TIMESTAMPTZ,
    total_count BIGINT
) AS $$
DECLARE
    dynamic_query TEXT;
    where_conditions TEXT[] := ARRAY[]::TEXT[];
    order_clause TEXT;
BEGIN
    -- Build WHERE conditions
    where_conditions := where_conditions || 'p.status = ''active''';

    IF search_text != '' THEN
        where_conditions := where_conditions ||
            '(to_tsvector(''english'', p.title || '' '' || p.description || '' '' || p.address) @@ plainto_tsquery(''english'', ''' || search_text || ''') OR ' ||
            'similarity(p.title, ''' || search_text || ''') > 0.3)';
    END IF;

    IF prop_type IS NOT NULL THEN
        where_conditions := where_conditions || 'p.property_type = ''' || prop_type || '''';
    END IF;

    IF list_type IS NOT NULL THEN
        where_conditions := where_conditions || 'p.listing_type = ''' || list_type || '''';
    END IF;

    IF min_price IS NOT NULL THEN
        where_conditions := where_conditions || 'p.price >= ' || min_price;
    END IF;

    IF max_price IS NOT NULL THEN
        where_conditions := where_conditions || 'p.price <= ' || max_price;
    END IF;

    IF min_beds IS NOT NULL THEN
        where_conditions := where_conditions || 'p.bedrooms >= ' || min_beds;
    END IF;

    IF max_beds IS NOT NULL THEN
        where_conditions := where_conditions || 'p.bedrooms <= ' || max_beds;
    END IF;

    IF min_baths IS NOT NULL THEN
        where_conditions := where_conditions || 'p.bathrooms >= ' || min_baths;
    END IF;

    IF city_name IS NOT NULL THEN
        where_conditions := where_conditions || 'LOWER(p.city) LIKE LOWER(''%' || city_name || '%'')';
    END IF;

    IF location_id IS NOT NULL THEN
        where_conditions := where_conditions || 'p.location_id = ''' || location_id || '''';
    END IF;

    IF featured_only THEN
        where_conditions := where_conditions || 'p.featured = TRUE';
    END IF;

    IF amenity_ids IS NOT NULL AND array_length(amenity_ids, 1) > 0 THEN
        where_conditions := where_conditions ||
            'p.id IN (SELECT pa.property_id FROM property_amenities pa WHERE pa.amenity_id = ANY(''' || amenity_ids || '''))';
    END IF;

    -- Build ORDER BY clause
    CASE sort_by
        WHEN 'price_asc' THEN order_clause := 'p.price ASC';
        WHEN 'price_desc' THEN order_clause := 'p.price DESC';
        WHEN 'bedrooms' THEN order_clause := 'p.bedrooms DESC';
        WHEN 'views' THEN order_clause := 'p.views_count DESC';
        WHEN 'featured' THEN order_clause := 'p.featured DESC, p.created_at DESC';
        ELSE order_clause := 'p.created_at ' || sort_order;
    END CASE;

    -- Build final query
    dynamic_query := '
        SELECT
            p.id, p.title, p.price, p.property_type, p.listing_type,
            p.address, p.city, p.bedrooms, p.bathrooms, p.square_feet,
            pi.image_url as primary_image,
            pr.full_name as agent_name,
            pr.phone as agent_phone,
            pr.agency_name,
            p.featured,
            p.views_count,
            p.created_at,
            COUNT(*) OVER() as total_count
        FROM properties p
        LEFT JOIN property_images pi ON p.id = pi.property_id AND pi.is_primary = TRUE
        LEFT JOIN profiles pr ON p.agent_id = pr.id
        WHERE ' || array_to_string(where_conditions, ' AND ') || '
        ORDER BY ' || order_clause || '
        LIMIT ' || limit_results || ' OFFSET ' || offset_results;

    RETURN QUERY EXECUTE dynamic_query;
END;
$$ LANGUAGE plpgsql;

-- =============================================
-- TRIGGERS
-- =============================================

CREATE TRIGGER set_updated_at BEFORE UPDATE ON profiles
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();

CREATE TRIGGER set_updated_at BEFORE UPDATE ON properties
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();

CREATE TRIGGER set_updated_at BEFORE UPDATE ON inquiries
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();

CREATE TRIGGER set_property_slug_trigger BEFORE INSERT OR UPDATE ON properties
    FOR EACH ROW EXECUTE FUNCTION set_property_slug();

CREATE TRIGGER increment_views_trigger AFTER INSERT ON property_views
    FOR EACH ROW EXECUTE FUNCTION increment_property_views();

CREATE TRIGGER increment_inquiries_trigger AFTER INSERT ON inquiries
    FOR EACH ROW EXECUTE FUNCTION increment_inquiry_count();

CREATE TRIGGER on_auth_user_created
    AFTER INSERT ON auth.users
    FOR EACH ROW EXECUTE FUNCTION handle_new_user();

CREATE TRIGGER on_auth_email_confirmed
    AFTER UPDATE ON auth.users
    FOR EACH ROW EXECUTE FUNCTION handle_email_confirmation();

-- =============================================
-- ROW LEVEL SECURITY
-- =============================================

ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE properties ENABLE ROW LEVEL SECURITY;
ALTER TABLE property_images ENABLE ROW LEVEL SECURITY;
ALTER TABLE property_amenities ENABLE ROW LEVEL SECURITY;
ALTER TABLE favorites ENABLE ROW LEVEL SECURITY;
ALTER TABLE inquiries ENABLE ROW LEVEL SECURITY;
ALTER TABLE property_views ENABLE ROW LEVEL SECURITY;
ALTER TABLE activity_logs ENABLE ROW LEVEL SECURITY;

-- Configuration tables (public read)
ALTER TABLE locations ENABLE ROW LEVEL SECURITY;
ALTER TABLE amenities ENABLE ROW LEVEL SECURITY;
ALTER TABLE settings ENABLE ROW LEVEL SECURITY;

-- Profile policies
CREATE POLICY "profiles_select" ON profiles FOR SELECT USING (true);
CREATE POLICY "profiles_update" ON profiles FOR UPDATE USING (auth.uid() = id);
CREATE POLICY "profiles_insert" ON profiles FOR INSERT WITH CHECK (auth.uid() = id);

-- Property policies
CREATE POLICY "properties_select" ON properties FOR SELECT USING (
    status = 'active' OR auth.uid() = agent_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);
CREATE POLICY "properties_insert" ON properties FOR INSERT WITH CHECK (
    auth.uid() = agent_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role IN ('agent', 'admin'))
);
CREATE POLICY "properties_update" ON properties FOR UPDATE USING (
    auth.uid() = agent_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);
CREATE POLICY "properties_delete" ON properties FOR DELETE USING (
    auth.uid() = agent_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);

-- Property images policies
CREATE POLICY "images_select" ON property_images FOR SELECT USING (
    EXISTS (SELECT 1 FROM properties WHERE id = property_id AND
        (status = 'active' OR agent_id = auth.uid() OR
         EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')))
);
CREATE POLICY "images_manage" ON property_images FOR ALL USING (
    EXISTS (SELECT 1 FROM properties WHERE id = property_id AND
        (agent_id = auth.uid() OR
         EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')))
);

-- Property amenities policies
CREATE POLICY "property_amenities_select" ON property_amenities FOR SELECT USING (true);
CREATE POLICY "property_amenities_manage" ON property_amenities FOR ALL USING (
    EXISTS (SELECT 1 FROM properties WHERE id = property_id AND
        (agent_id = auth.uid() OR
         EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')))
);

-- Favorites policies
CREATE POLICY "favorites_manage" ON favorites FOR ALL USING (auth.uid() = user_id);

-- Inquiries policies
CREATE POLICY "inquiries_insert" ON inquiries FOR INSERT WITH CHECK (true);
CREATE POLICY "inquiries_select" ON inquiries FOR SELECT USING (
    auth.uid() = agent_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin') OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND email = inquirer_email)
);
CREATE POLICY "inquiries_update" ON inquiries FOR UPDATE USING (
    auth.uid() = agent_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);

-- Property views policies
CREATE POLICY "property_views_insert" ON property_views FOR INSERT WITH CHECK (true);
CREATE POLICY "property_views_select" ON property_views FOR SELECT USING (
    auth.uid() = user_id OR
    EXISTS (SELECT 1 FROM properties WHERE id = property_id AND agent_id = auth.uid()) OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);

-- Activity logs policies
CREATE POLICY "activity_logs_insert" ON activity_logs FOR INSERT WITH CHECK (true);
CREATE POLICY "activity_logs_select" ON activity_logs FOR SELECT USING (
    auth.uid() = user_id OR
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);

-- Configuration table policies (public read)
CREATE POLICY "locations_select" ON locations FOR SELECT USING (true);
CREATE POLICY "amenities_select" ON amenities FOR SELECT USING (true);
CREATE POLICY "settings_select" ON settings FOR SELECT USING (true);

-- Admin-only policies for configuration
CREATE POLICY "locations_manage" ON locations FOR ALL USING (
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);
CREATE POLICY "amenities_manage" ON amenities FOR ALL USING (
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);
CREATE POLICY "settings_manage" ON settings FOR ALL USING (
    EXISTS (SELECT 1 FROM profiles WHERE id = auth.uid() AND role = 'admin')
);

